# WebSocket connection URL for real-time dashboard data (internal Docker network)
VITE_WS_URL=ws://ctaaapi-production:3006

# Enable mock data mode (set to 'false' for production)
VITE_ENABLE_MOCK_DATA=false

# API endpoints (if needed for REST calls) - internal Docker network
VITE_API_BASE_URL=http://ctaaapi-production:3006/api

# Dashboard configuration
VITE_DEFAULT_MODE=personal
VITE_REFRESH_INTERVAL=1000