# WebSocket connection URL for real-time dashboard data
VITE_WS_URL=ws://localhost:3001

# Enable mock data mode (set to 'true' to use mock data instead of WebSocket)
VITE_ENABLE_MOCK_DATA=true

# API endpoints (if needed for REST calls)
VITE_API_BASE_URL=http://localhost:3001/api

# Dashboard configuration
VITE_DEFAULT_MODE=personal
VITE_REFRESH_INTERVAL=1000